* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
# Released model data and binary assets use Git LFS. Install Git LFS before cloning.
mods/**/assets/**/shapes/**/*.json filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

*.txt text eol=lf
*.html text eol=lf
*.in text eol=lf
*.fsh text eol=lf
*.vsh text eol=lf
