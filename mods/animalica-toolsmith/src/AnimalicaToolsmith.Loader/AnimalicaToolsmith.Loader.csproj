<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnimalicaToolsmith.Loader</AssemblyName>
    <GameDir Condition="'$(GameDir)' == ''">$(VINTAGE_STORY)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="../AnimalicaToolsmith/bin/Release/net10.0/AnimalicaToolsmith.dll" LogicalName="providers.toolsmith" />
    <EmbeddedResource Include="../AnimalicaToolsmith.Lto/bin/Release/net10.0/AnimalicaToolsmith.Lto.dll" LogicalName="providers.ltobsplus" />
  </ItemGroup>
</Project>
